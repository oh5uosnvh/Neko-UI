diff --git a/app/src/main/java/io/nekohasekai/sagernet/ui/MainActivity.kt b/app/src/main/java/io/nekohasekai/sagernet/ui/MainActivity.kt
index c970380..5795976 100644
--- a/app/src/main/java/io/nekohasekai/sagernet/ui/MainActivity.kt
+++ b/app/src/main/java/io/nekohasekai/sagernet/ui/MainActivity.kt
@@ -714,6 +714,15 @@ class MainActivity : ThemedActivity(),
             runOnDefaultDispatcher {
                 runCatching { IpQualityLookup.prefetch() }
             }
+            // 027: 连接成功自动 ping 一次主连接，延迟区直接出数值（不靠点击）
+            runOnDefaultDispatcher {
+                runCatching {
+                    val elapsed = urlTest()
+                    onMainDispatcher { binding.connectBar.showDelay(elapsed) }
+                }.onFailure {
+                    onMainDispatcher { binding.connectBar.showDelayError() }
+                }
+            }
         }
         if (msg != null) snackbar(getString(R.string.vpn_error, msg)).show()
     }
