+    /** 018: 长按分组标签 → 删除分组（带还原）。snackbar 超时（或滑动消失）后不可恢复。 */
+    fun deleteGroupWithUndo(group: ProxyGroup) {
+        runOnDefaultDispatcher {
+            val profiles = SagerDatabase.proxyDao.getByGroup(group.id)
+            val wasCurrent = DataStore.currentGroupId() == group.id
+            GroupManager.deleteGroup(group.id)
+            if (wasCurrent) {
+                // 删除的是当前分组 → 先切到第一个剩余分组，避免 pager 悬在已删分组
+                SagerDatabase.groupDao.allGroups().firstOrNull()?.let {
+                    DataStore.selectedGroup = it.id
+                }
+            }
+            onMainDispatcher {
+                if (!isAdded) return@onMainDispatcher
+                snackbar(getString(R.string.group_deleted_undo, group.displayName())).apply {
+                    setAction(R.string.undo) {
+                        runOnDefaultDispatcher {
+                            restoreGroup(group, profiles, wasCurrent)
+                        }
+                    }
+                    duration = Snackbar.LENGTH_LONG
+                }.show()
+            }
+        }
+    }
+
+    /** 018: 还原刚删除的分组（按原 id 回插，节点随组恢复）。 */
+    private suspend fun restoreGroup(group: ProxyGroup, profiles: List<ProxyEntity>, wasCurrent: Boolean) {
+        SagerDatabase.groupDao.createGroup(group)
+        if (profiles.isNotEmpty()) {
+            SagerDatabase.proxyDao.insert(profiles)
+        }
+        if (wasCurrent) {
+            DataStore.selectedGroup = group.id
+        }
+        GroupManager.postReload(group.id)
+    }
+
