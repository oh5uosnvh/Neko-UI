diff --git a/app/src/main/java/io/nekohasekai/sagernet/ui/IpQualityLookup.kt b/app/src/main/java/io/nekohasekai/sagernet/ui/IpQualityLookup.kt
new file mode 100644
index 0000000..6aded04
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sagernet/ui/IpQualityLookup.kt
@@ -0,0 +1,342 @@
+package io.nekohasekai.sagernet.ui
+
+import io.nekohasekai.sagernet.ktx.Logs
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.selects.select
+import kotlinx.coroutines.withTimeoutOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.TimeUnit
+
+/**
+ * 025/028: 出站 IP 质量查询 —— 复刻 FlClash v0.8.99 多源对冲语义。
+ *
+ * 028 关键修复：
+ * - **先答先赢回归**（026 曾为合并国家改成等全部源完成，最慢 8s 拖死整体）：
+ *   select/onAwait 按完成顺序消费，第一个非推断结果立即胜出；胜者缺国家地区时
+ *   仅宽限 1.5s 等其他源补国家，补不到就先用，绝不拖慢主结果。
+ * - **缓存绑定节点身份**（profileId）：切换节点/VPN 重连 → 缓存自动失效 → 重查，
+ *   不再“无动于衷”。
+ * - 预查询：VPN 连接瞬间由 MainActivity 触发（点开 ⓘ 秒出）；失败不冲缓存。
+ * 查询经 VPN 隧道（应用自身流量走 TUN），测的是节点出口 IP。
+ */
+object IpQualityLookup {
+
+    data class IpQuality(
+        val ip: String,
+        val source: String,
+        val type: String, // residential / mobile / business / hosting
+        val organization: String?,
+        val asn: Int?,
+        val isProxy: Boolean,
+        val isVpn: Boolean,
+        val isTor: Boolean,
+        val isAbuser: Boolean,
+        val country: String?,
+        val inferred: Boolean,
+        val elapsedMs: Long = 0,
+    ) {
+        val level: String
+            get() = when {
+                isTor || isAbuser -> "risky"
+                type == "hosting" -> "normal"
+                else -> "good"
+            }
+
+        val flags: List<String>
+            get() = buildList {
+                if (isTor) add("tor")
+                if (isAbuser) add("abuser")
+                if (isVpn) add("vpn")
+                if (isProxy) add("proxy")
+            }
+    }
+
+    data class CacheEntry(val quality: IpQuality, val profileId: Long, val atMs: Long)
+
+    @Volatile
+    private var cache: CacheEntry? = null
+
+    private const val CACHE_FRESH_MS = 60_000L      // 同节点 1 分钟内不重复查
+    private const val TOTAL_TIMEOUT_MS = 10_000L    // 六源对冲总超时
+    private const val COUNTRY_GRACE_MS = 1_500L     // 胜者缺国家时的宽限期
+
+    /** 指定节点的缓存（节点不匹配 = 视为无缓存）。 */
+    fun cacheFor(profileId: Long): CacheEntry? =
+        cache?.takeIf { it.profileId == profileId }
+
+    /** 新鲜缓存（同节点 + maxAgeMs 内）——预查询跳过判断用。 */
+    fun freshCache(profileId: Long, maxAgeMs: Long = CACHE_FRESH_MS): CacheEntry? =
+        cacheFor(profileId)?.takeIf { System.currentTimeMillis() - it.atMs < maxAgeMs }
+
+    /** 成功后写缓存（绑定节点）。 */
+    suspend fun lookup(forProfile: Long): IpQuality {
+        val q = doLookup()
+        cache = CacheEntry(q, forProfile, System.currentTimeMillis())
+        return q
+    }
+
+    /** 026/028: 预查询 —— 节点匹配且有新鲜缓存则跳过，否则后台重查。 */
+    suspend fun prefetch(forProfile: Long) {
+        if (freshCache(forProfile) == null) {
+            runCatching { lookup(forProfile) }.onFailure { Logs.w("ip prefetch: ${it.message}") }
+        }
+    }
+
+    private class SourceFailure(val kind: String) : Exception(kind)
+
+    private val client by lazy {
+        OkHttpClient.Builder()
+            .connectTimeout(8, TimeUnit.SECONDS)
+            .readTimeout(8, TimeUnit.SECONDS)
+            .callTimeout(8, TimeUnit.SECONDS)
+            .build()
+    }
+
+    private fun getJson(url: String): JSONObject {
+        val request = Request.Builder().url(url).build()
+        client.newCall(request).execute().use { response ->
+            if (response.code == 429) throw SourceFailure("rateLimited")
+            if (response.code != 200) throw SourceFailure("failed")
+            return JSONObject(response.body?.string().orEmpty())
+        }
+    }
+
+    // ---- FlClash helpers ----
+    private fun obj(value: Any?): JSONObject =
+        if (value is JSONObject) value else JSONObject()
+
+    private fun flag(value: Any?): Boolean = value == true
+
+    private fun text(value: Any?): String? =
+        (value as? String)?.takeIf { it.isNotEmpty() }
+
+    private fun asnOf(value: Any?): Int? = when (value) {
+        is Int -> value.takeIf { it != 0 }
+        is String -> Regex("\\d+").find(value)?.value?.toIntOrNull()?.takeIf { it != 0 }
+        else -> null
+    }
+
+    private fun declaredType(value: Any?): String? = when (value) {
+        "isp" -> "residential"
+        "business", "education", "government", "banking" -> "business"
+        "hosting" -> "hosting"
+        else -> null
+    }
+
+    private fun pickType(hosting: Boolean, mobile: Boolean = false, declared: String? = null): String? =
+        when {
+            hosting || declared == "hosting" -> "hosting"
+            mobile -> "mobile"
+            else -> declared
+        }
+
+    private fun quality(
+        ip: String, source: String, type: String?, inferred: Boolean = false,
+        organization: String? = null, asn: Int? = null, country: String? = null,
+        isProxy: Boolean = false, isVpn: Boolean = false,
+        isTor: Boolean = false, isAbuser: Boolean = false, elapsedMs: Long = 0,
+    ): IpQuality? {
+        if (type == null) return null
+        return IpQuality(
+            ip, source, type, organization, asn, isProxy, isVpn, isTor, isAbuser,
+            country, inferred, elapsedMs
+        )
+    }
+
+    // ---- 六源解析（与 FlClash _fromXxx 一一对应） ----
+    private fun fromIdentMe(): IpQuality {
+        val json = getJson("https://ident.me/json")
+        val type = declaredType(json.optString("type"))
+        return quality(
+            json.optString("ip"), "ident.me", type,
+            inferred = type == null,
+            organization = text(json.optString("aso")),
+            asn = asnOf(json.opt("asn")),
+        ) ?: throw SourceFailure("noType")
+    }
+
+    private fun fromIpApiCom(): IpQuality {
+        val json = getJson(
+            "http://ip-api.com/json/?fields=status,message,query,country,isp,org,as,mobile,proxy,hosting&lang=zh-CN"
+        )
+        if (json.optString("status") != "success") throw SourceFailure("failed")
+        val type = pickType(hosting = flag(json.opt("hosting")), mobile = flag(json.opt("mobile")))
+        return quality(
+            json.optString("query"), "ip-api.com", type,
+            inferred = type == null,
+            organization = text(json.optString("org")) ?: text(json.optString("isp")),
+            asn = asnOf(json.optString("as")),
+            country = text(json.optString("country")),
+            isProxy = flag(json.opt("proxy")),
+        ) ?: throw SourceFailure("noType")
+    }
+
+    private fun fromIpQuery(): IpQuality {
+        val json = getJson("https://api.ipquery.io/?format=json")
+        val risk = obj(json.opt("risk"))
+        val isp = obj(json.opt("isp"))
+        val type = pickType(
+            hosting = flag(risk.opt("is_datacenter")),
+            mobile = flag(risk.opt("is_mobile")),
+        )
+        return quality(
+            json.optString("ip"), "ipquery.io", type,
+            inferred = type == null,
+            organization = text(isp.opt("org")) ?: text(isp.opt("isp")),
+            asn = asnOf(isp.opt("asn")),
+            country = text(obj(json.opt("location")).opt("country")),
+            isProxy = flag(risk.opt("is_proxy")),
+            isVpn = flag(risk.opt("is_vpn")),
+            isTor = flag(risk.opt("is_tor")),
+        ) ?: throw SourceFailure("noType")
+    }
+
+    private fun fromIpLocate(): IpQuality {
+        val json = getJson("https://iplocate.io/api/lookup/")
+        val privacy = obj(json.opt("privacy"))
+        val company = obj(json.opt("company"))
+        val asn = obj(json.opt("asn"))
+        val type = pickType(
+            hosting = flag(privacy.opt("is_hosting")),
+            declared = declaredType(company.opt("type")) ?: declaredType(asn.opt("type")),
+        )
+        return quality(
+            json.optString("ip"), "iplocate.io", type,
+            inferred = type == null,
+            organization = text(company.opt("name")) ?: text(asn.opt("name")),
+            asn = asnOf(asn.opt("asn")),
+            country = text(json.optString("country")),
+            isProxy = flag(privacy.opt("is_proxy")),
+            isVpn = flag(privacy.opt("is_vpn")),
+            isTor = flag(privacy.opt("is_tor")),
+            isAbuser = flag(privacy.opt("is_abuser")),
+        ) ?: throw SourceFailure("noType")
+    }
+
+    private fun fromIpApiIs(): IpQuality {
+        val json = getJson("https://api.ipapi.is/")
+        val company = obj(json.opt("company"))
+        val asn = obj(json.opt("asn"))
+        val type = pickType(
+            hosting = flag(json.opt("is_datacenter")),
+            mobile = flag(json.opt("is_mobile")),
+            declared = declaredType(company.opt("type")) ?: declaredType(asn.opt("type")),
+        )
+        return quality(
+            json.optString("ip"), "ipapi.is", type,
+            inferred = type == null,
+            organization = text(company.opt("name")) ?: text(asn.opt("org")),
+            asn = asnOf(asn.opt("asn")),
+            country = text(obj(json.opt("location")).opt("country")),
+            isProxy = flag(json.opt("is_proxy")),
+            isVpn = flag(json.opt("is_vpn")),
+            isTor = flag(json.opt("is_tor")),
+            isAbuser = flag(json.opt("is_abuser")),
+        ) ?: throw SourceFailure("noType")
+    }
+
+    private fun fromProxyCheck(): IpQuality {
+        val json = getJson("https://proxycheck.io/v3/?risk=1&vpn=1&asn=1")
+        val status = json.optString("status")
+        if (status == "denied") throw SourceFailure("rateLimited")
+        if (status != "ok" && status != "warning") throw SourceFailure("failed")
+        val ipKey = json.keys().asSequence().firstOrNull { it != "status" } ?: throw SourceFailure("noType")
+        val result = obj(json.opt(ipKey))
+        val network = obj(result.opt("network"))
+        val detections = obj(result.opt("detections"))
+        val networkType = network.optString("type")
+        val type = pickType(
+            hosting = flag(detections.opt("hosting")) || networkType == "Hosting",
+            mobile = networkType == "Wireless",
+            declared = when (networkType) {
+                "Residential" -> "residential"
+                "Business" -> "business"
+                else -> null
+            },
+        )
+        return quality(
+            ipKey, "proxycheck.io", type,
+            inferred = type == null,
+            organization = text(network.opt("organisation")),
+            asn = asnOf(network.opt("asn")),
+            country = text(obj(result.opt("location")).opt("country")),
+            isProxy = flag(detections.opt("proxy")),
+            isVpn = flag(detections.opt("vpn")),
+            isTor = flag(detections.opt("tor")),
+        ) ?: throw SourceFailure("noType")
+    }
+
+    private data class Done(val idx: Int, val quality: IpQuality?)
+
+    /**
+     * 028: 六源并发 + select/onAwait 按完成顺序消费：
+     * - 第一个“非推断”结果立即胜出（先答先赢，不等慢源）；
+     * - 胜者缺国家地区 → 宽限 1.5s 等其他非推断源补国家，补不到就照常返回；
+     * - 推断结果仅作全败兜底；总超时 10s。
+     */
+    private suspend fun doLookup(): IpQuality = coroutineScope {
+        val started = System.currentTimeMillis()
+        val fetchers = listOf(
+            ::fromIdentMe, ::fromIpApiCom, ::fromIpQuery,
+            ::fromIpLocate, ::fromIpApiIs, ::fromProxyCheck,
+        )
+        val jobs = fetchers.mapIndexed { idx, fetcher ->
+            async(Dispatchers.IO) {
+                val t0 = System.currentTimeMillis()
+                val q = runCatching { fetcher() }
+                    .onFailure { Logs.w("ip source failed: ${it.message}") }
+                    .getOrNull()
+                Done(idx, q?.copy(elapsedMs = System.currentTimeMillis() - t0))
+            }
+        }
+        val pending = jobs.toMutableList()
+        var fallback: IpQuality? = null
+        var winner: IpQuality? = null
+
+        while (pending.isNotEmpty() && winner == null) {
+            val done = withTimeoutOrNull(TOTAL_TIMEOUT_MS - (System.currentTimeMillis() - started)) {
+                select<Done> {
+                    pending.forEach { d -> d.onAwait { it } }
+                }
+            } ?: break
+            pending.removeAll { it === jobs[done.idx] }
+            val q = done.quality ?: continue
+            if (q.inferred) {
+                fallback = fallback ?: q
+                continue
+            }
+            if (q.country != null) {
+                winner = q
+                break
+            }
+            // 胜者缺国家：宽限窗口内等其他非推断源补齐
+            winner = q
+            val graceEnd = System.currentTimeMillis() + COUNTRY_GRACE_MS
+            while (pending.isNotEmpty() && winner?.country == null) {
+                val done2 = withTimeoutOrNull(graceEnd - System.currentTimeMillis()) {
+                    select<Done> {
+                        pending.forEach { d -> d.onAwait { it } }
+                    }
+                } ?: break
+                pending.removeAll { it === jobs[done2.idx] }
+                val q2 = done2.quality ?: continue
+                if (q2.inferred) {
+                    fallback = fallback ?: q2
+                    continue
+                }
+                if (q2.country != null && winner != null) {
+                    winner = winner.copy(country = q2.country)
+                }
+            }
+        }
+
+        (winner?.copy(country = winner.country ?: fallback?.country))
+            ?: fallback
+            ?: throw IOException("all ip sources failed")
+    }
+}
