+++ b/app/src/main/res/layout/layout_connect_bar.xml
@@ -0,0 +1,108 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- 017: 底部长条启动栏内容。背景/圆角由外层 ConnectBar(MaterialCardView) 承担。
+     高度 64dp ≈ 节点卡片「地址行 + 协议/延迟行」两行的高度；
+     左右 2dp 边距与节点卡片对齐（layout_profile.xml margin=2dp）。 -->
+<merge xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:tools="http://schemas.android.com/tools"
+    tools:parentTag="com.google.android.material.card.MaterialCardView"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="10dp"
+        android:paddingEnd="10dp"
+        android:paddingTop="8dp"
+        android:paddingBottom="8dp">
+
+        <!-- ⓘ 出站 IP 查询（竖直居中，占满两行） -->
+        <androidx.appcompat.widget.AppCompatImageView
+            android:id="@+id/bar_ip_info"
+            android:layout_width="36dp"
+            android:layout_height="36dp"
+            android:layout_gravity="center_vertical"
+            android:scaleType="fitCenter"
+            android:background="@drawable/bg_touch_rounded"
+            android:contentDescription="@string/outbound_ip"
+            app:srcCompat="@drawable/ic_outbound_ip"
+            app:tint="@color/white" />
+
+        <!-- [2] 上传/下载：固定冗余宽度（容纳 ▲ 999 MB/s 级别文案，
+             网速变化时框宽恒定不抖动） -->
+        <LinearLayout
+            android:id="@+id/bar_speed_zone"
+            android:layout_width="88dp"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="6dp"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/bar_tx"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:textColor="@color/white"
+                android:textSize="12sp"
+                tools:text="▲ 0 B/s" />
+
+            <TextView
+                android:id="@+id/bar_rx"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:textColor="@color/white"
+                android:textSize="12sp"
+                tools:text="▼ 0 B/s" />
+        </LinearLayout>
+
+        <!-- [3] 实时延迟：值在上、标签在下；固定宽度 —— 文案切换时区域宽度不变 -->
+        <LinearLayout
+            android:id="@+id/bar_delay_zone"
+            android:layout_width="76dp"
+            android:layout_height="match_parent"
+            android:layout_marginEnd="4dp"
+            android:gravity="center_vertical"
+            android:orientation="vertical"
+            android:paddingStart="10dp"
+            android:paddingEnd="4dp">
+
+            <TextView
+                android:id="@+id/bar_delay_value"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:text="@string/bar_delay_tap"
+                android:textColor="@color/white"
+                android:textSize="12sp" />
+
+            <TextView
+                android:id="@+id/bar_delay_label"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:alpha="0.72"
+                android:singleLine="true"
+                android:text="@string/bar_delay_label"
+                android:textColor="@color/white"
+                android:textSize="11sp" />
+        </LinearLayout>
+
+        <!-- [4] 启动/关闭：官方 AVD 动画引擎（斜线划出/飞机形变），无自绘底色。
+             进度环已移除（源码遗留“转圈”显示问题） -->
+        <io.nekohasekai.sagernet.widget.ServiceIconView
+            android:id="@+id/bar_fab"
+            android:layout_width="36dp"
+            android:layout_height="36dp"
+            android:background="@drawable/bg_touch_rounded"
+            android:contentDescription="@string/connect"
+            android:scaleType="fitCenter"
+            app:srcCompat="@drawable/ic_service_idle" />
+
+    </LinearLayout>
+</merge>
