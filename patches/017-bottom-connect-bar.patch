+package io.nekohasekai.sagernet.widget
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.ViewGroup
+import android.widget.TextView
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.fragment.app.FragmentActivity
+import android.text.format.Formatter
+import com.google.android.material.card.MaterialCardView
+import io.nekohasekai.sagernet.R
+import io.nekohasekai.sagernet.SagerNet
+import io.nekohasekai.sagernet.aidl.TrafficData
+import io.nekohasekai.sagernet.bg.BaseService
+import io.nekohasekai.sagernet.database.DataStore
+import io.nekohasekai.sagernet.database.ProfileManager
+import io.nekohasekai.sagernet.database.ProxyEntity
+import io.nekohasekai.sagernet.ktx.dp2px
+import io.nekohasekai.sagernet.ui.MainActivity
+import io.nekohasekai.sagernet.ui.OutboundIpDialogFragment
+
+/**
+ * 017: 底部长条启动栏 —— 替代官方 FAB + StatsBar（实时数据托板）。
+ *
+ * 布局（横向）：ⓘ 出站IP查询 | 上传/下载(上下两行) | 实时延迟(标签+值两行，点按测试) | 启动按钮
+ * - 栏高 64dp ≈ 节点卡片两行；左右 2dp 与卡片对齐；底边距 4dp（滚动到底时与末卡片
+ *   间距 = 卡片间距）。
+ * - 常驻显示，不再随滚动隐藏（官方 hideOnScroll 逻辑一并移除）。
+ * - 启动按钮沿用 ServiceButton（状态动画 + 进度环），点击 start/stop 与原 FAB 相同。
+ * - 延迟值来源：① 点按延迟区 → 主连接 urlTest（原 StatsBar 点击语义）；
+ *   ② ProfileManager 实时广播 → 当前选中节点的测试结果（012 实时回写链路）。
+ */
+class ConnectBar @JvmOverloads constructor(
+    context: Context, attrs: AttributeSet? = null, defStyleAttr: Int = 0,
+) : MaterialCardView(context, attrs, defStyleAttr) {
+
+    companion object {
+        private const val BASE_BOTTOM_MARGIN_DP = 4
+    }
+
+    private val ipInfo: androidx.appcompat.widget.AppCompatImageView
+    private val txText: TextView
+    private val rxText: TextView
+    private val delayZone: ViewGroup
+    private val delayValue: TextView
+    private val serviceButton: ServiceButton
+    private val serviceProgress: com.google.android.material.progressindicator.CircularProgressIndicator
+
+    private var currentState = BaseService.State.Idle
+
+    /** 连接测试回调（由 MainActivity 注入：主连接 urlTest）。 */
+    var onTestConnection: (() -> Unit)? = null
+
+    private val profileListener = object : ProfileManager.Listener {
+        override suspend fun onAdd(profile: ProxyEntity) = Unit
+        override suspend fun onUpdated(data: List<TrafficData>) = Unit
+        override suspend fun onUpdated(profile: ProxyEntity, noTraffic: Boolean) {
+            if (noTraffic) return
+            if (profile.id != DataStore.currentProfile) return
+            if (profile.status == 1 && profile.ping > 0) {
+                post { showDelay(profile.ping) }
+            }
+        }
+
+        override suspend fun onRemoved(groupId: Long, profileId: Long) = Unit
+    }
+
+    init {
+        inflate(context, R.layout.layout_connect_bar, this)
+        ipInfo = findViewById(R.id.bar_ip_info)
+        txText = findViewById(R.id.bar_tx)
+        rxText = findViewById(R.id.bar_rx)
+        delayZone = findViewById(R.id.bar_delay_zone)
+        delayValue = findViewById(R.id.bar_delay_value)
+        serviceButton = findViewById(R.id.bar_fab)
+        serviceProgress = findViewById(R.id.bar_fab_progress)
+
+        serviceButton.initProgress(serviceProgress)
+        serviceButton.setOnClickListener {
+            if (DataStore.serviceState.canStop) {
+                SagerNet.stopService()
+            } else {
+                (context as? MainActivity)?.launchConnect()
+            }
+        }
+
+        delayZone.setOnClickListener {
+            if (DataStore.serviceState.connected) {
+                setTesting()
+                onTestConnection?.invoke()
+            }
+        }
+
+        ipInfo.setOnClickListener {
+            val activity = context as? FragmentActivity ?: return@setOnClickListener
+            // 防重复：已有实例则不叠开
+            if (activity.supportFragmentManager
+                    .findFragmentByTag(OutboundIpDialogFragment.DIALOG_TAG) == null
+            ) {
+                OutboundIpDialogFragment()
+                    .show(activity.supportFragmentManager, OutboundIpDialogFragment.DIALOG_TAG)
+            }
+        }
+
+        // 导航栏 inset：底边距 = 4dp + 系统导航条高度（手势条 / 三大金刚都适用）
+        ViewCompat.setOnApplyWindowInsetsListener(this) { v, insets ->
+            val nav = insets.getInsets(WindowInsetsCompat.Type.navigationBars()).bottom
+            (v.layoutParams as? ViewGroup.MarginLayoutParams)?.let { lp ->
+                val target = dp2px(BASE_BOTTOM_MARGIN_DP) + nav
+                if (lp.bottomMargin != target) {
+                    lp.bottomMargin = target
+                    v.requestLayout()
+                }
+            }
+            insets
+        }
+
+        updateSpeed(0, 0)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        ProfileManager.addListener(profileListener)
+    }
+
+    override fun onDetachedFromWindow() {
+        ProfileManager.removeListener(profileListener)
+        super.onDetachedFromWindow()
+    }
+
+    fun changeState(state: BaseService.State) {
+        serviceButton.changeState(state, currentState, true)
+        currentState = state
+        if (state != BaseService.State.Connected) {
+            delayValue.setText(R.string.bar_delay_tap)
+        }
+    }
+
