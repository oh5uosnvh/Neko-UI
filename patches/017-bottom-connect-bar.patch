+<?xml version="1.0" encoding="utf-8"?>
+<!-- 017: 底部长条启动栏内容。背景/圆角由外层 ConnectBar(MaterialCardView) 承担。
+     高度 64dp ≈ 节点卡片「地址行 + 协议/延迟行」两行的高度；
+     左右 2dp 边距与节点卡片对齐（layout_profile.xml margin=2dp）。 -->
+<merge xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:tools="http://schemas.android.com/tools"
+    tools:parentTag="com.google.android.material.card.MaterialCardView"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="14dp"
+        android:paddingEnd="10dp"
+        android:paddingTop="8dp"
+        android:paddingBottom="8dp">
+
+        <!-- ⓘ 出站 IP 查询（竖直居中，占满两行） -->
+        <androidx.appcompat.widget.AppCompatImageView
+            android:id="@+id/bar_ip_info"
+            android:layout_width="wrap_content"
+            android:layout_height="match_parent"
+            android:adjustViewBounds="true"
+            android:scaleType="fitCenter"
+            android:background="?attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/outbound_ip"
+            android:padding="8dp"
+            app:srcCompat="@drawable/ic_outbound_ip"
+            app:tint="@color/white" />
+
+        <!-- 上传/下载：上下各一行 -->
+        <LinearLayout
+            android:id="@+id/bar_speed_zone"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="10dp"
+            android:layout_weight="1"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/bar_tx"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:textColor="@color/white"
+                android:textSize="12sp"
+                tools:text="▲ 0 B/s" />
+
+            <TextView
+                android:id="@+id/bar_rx"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:textColor="@color/white"
+                android:textSize="12sp"
+                tools:text="▼ 0 B/s" />
+        </LinearLayout>
+
+        <!-- 实时延迟：标签 + 值 上下两行；点按 = 连接测试 -->
+        <LinearLayout
+            android:id="@+id/bar_delay_zone"
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_weight="1"
+            android:background="?android:attr/selectableItemBackground"
+            android:gravity="center_vertical"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/bar_delay_label"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:alpha="0.72"
+                android:singleLine="true"
+                android:text="@string/bar_delay_label"
+                android:textColor="@color/white"
+                android:textSize="11sp" />
+
+            <TextView
+                android:id="@+id/bar_delay_value"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:singleLine="true"
+                android:text="@string/bar_delay_tap"
+                android:textColor="@color/white"
+                android:textSize="12sp" />
+        </LinearLayout>
+
+        <!-- 启动/关闭按钮 + 连接进度环 -->
+        <FrameLayout
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content">
+
+            <io.nekohasekai.sagernet.widget.ServiceButton
+                android:id="@+id/bar_fab"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                app:fabSize="mini"
+                android:elevation="4dp"
+                app:backgroundTint="?attr/colorPrimary"
+                app:srcCompat="@drawable/ic_service_idle" />
+
+            <com.google.android.material.progressindicator.CircularProgressIndicator
+                android:id="@+id/bar_fab_progress"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:layout_gravity="center"
+                android:indeterminate="true"
+                android:max="1"
+                android:visibility="invisible"
+                app:indicatorColor="?primaryOrTextSecondary"
+                app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
+                app:trackThickness="3dp" />
+        </FrameLayout>
+
+    </LinearLayout>
+</merge>
