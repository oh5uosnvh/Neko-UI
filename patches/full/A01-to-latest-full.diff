+             * 兜底分片填充（20/20）：由 armFallback 看门狗调用——官方装载偏慢
+             * （部分 70-80 节点分组）或竞态未落地时接管——首屏先出 20 张，
+             * 其余按 20 个/步官方 post 写法流式补齐。每步校验数据一致性，
+             * 检测到并发写入时直接一次性全量刷新收尾。完成后数据常驻适配器。
+             */
+            private fun applyFirstFill(
+                map: Map<Long, ProxyEntity>,
+                ids: List<Long>,
+                selectedProfileIndex: Int,
+            ) {
+                val chunk = 20
+                var from = 0
+                fun step() {
+                    if (!::configurationListView.isInitialized) return
+                    if (configurationIdList.size != from) {
+                        // 检测到并发写入（罕见）：全量刷新一次收尾
+                        configurationList.clear()
+                        configurationList.putAll(map)
+                        configurationIdList.clear()
+                        configurationIdList.addAll(ids)
+                        notifyDataSetChanged()
+                        return
+                    }
+                    val to = minOf(from + chunk, ids.size)
+                    for (i in from until to) {
+                        configurationList[ids[i]] = map.getValue(ids[i])
+                        configurationIdList.add(ids[i])
+                    }
+                    if (from == 0) {
+                        notifyDataSetChanged()
+                        configurationListView.scrollToPosition(0)
+                    } else {
+                        notifyItemRangeInserted(from, to - from)
+                    }
+                    if (selectedProfileIndex in from until to) {
+                        configurationListView.scrollTo(selectedProfileIndex, false)
+                    }
+                    from = to
+                    if (from < ids.size) {
+                        configurationListView.post { step() }
+                    }
                 }
+                step()
             }
 
         }
