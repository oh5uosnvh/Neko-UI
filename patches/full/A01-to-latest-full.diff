+package io.nekohasekai.sagernet.ui
+
+import android.app.Dialog
+import android.os.Bundle
+import android.view.View
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+import androidx.fragment.app.DialogFragment
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import io.nekohasekai.sagernet.R
+import io.nekohasekai.sagernet.SagerNet
+import io.nekohasekai.sagernet.database.DataStore
+import io.nekohasekai.sagernet.ktx.Logs
+import io.nekohasekai.sagernet.ktx.onMainDispatcher
+import io.nekohasekai.sagernet.ktx.readableMessage
+import io.nekohasekai.sagernet.ktx.runOnDefaultDispatcher
+
+/**
+ * 017: 出站 IP 查询弹窗 —— 复刻 FlClash v0.8.99 出站 IP 面板。
+ * 026: 打开即读缓存（VPN 连接时已预查询，秒出）；刷新强制重查；
+ * 失败保留已有信息（不再把成功结果冲成全红错误），零缓存才显示错误。
+ */
+class OutboundIpDialogFragment : DialogFragment() {
+
+    companion object {
+        const val DIALOG_TAG = "outbound_ip_dialog"
+    }
+
+    private var loading = false
+
+    private lateinit var ipValue: TextView
+    private lateinit var countryValue: TextView
+    private lateinit var levelValue: TextView
+    private lateinit var typeValue: TextView
+    private lateinit var flagsValue: TextView
+    private lateinit var orgValue: TextView
+    private lateinit var asnValue: TextView
+    private lateinit var sourceValue: TextView
+
+    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog {
+        val view = layoutInflater.inflate(R.layout.layout_outbound_ip_dialog, null)
+        ipValue = view.findViewById(R.id.ip_value)
+        countryValue = view.findViewById(R.id.ip_country_value)
+        levelValue = view.findViewById(R.id.ip_level_value)
+        typeValue = view.findViewById(R.id.ip_type_value)
+        flagsValue = view.findViewById(R.id.ip_flags_value)
+        orgValue = view.findViewById(R.id.ip_org_value)
+        asnValue = view.findViewById(R.id.ip_asn_value)
+        sourceValue = view.findViewById(R.id.ip_source_value)
+
+        // 019: 仅 IP 地址 / 组织 / ASN 三行点击复制
+        bindCopy(view.findViewById(R.id.row_ip), ipValue)
+        bindCopy(view.findViewById(R.id.row_org), orgValue)
+        bindCopy(view.findViewById(R.id.row_asn), asnValue)
+
+        val dialog = MaterialAlertDialogBuilder(requireContext())
+            .setTitle(R.string.outbound_ip)
+            .setView(view)
+            .setNeutralButton(R.string.ip_action_refresh, null)
+            .setPositiveButton(android.R.string.ok, null)
+            .create()
+
+        dialog.setOnShowListener {
+            // 刷新不关闭（强制重查）；确定正常关闭
+            dialog.getButton(Dialog.BUTTON_NEUTRAL).setOnClickListener { fetch(force = true) }
+            dialog.getButton(Dialog.BUTTON_POSITIVE).setOnClickListener { dismiss() }
+        }
+
+        fetch(force = false)
+        return dialog
+    }
+
+    private fun bindCopy(row: View?, valueView: TextView) {
+        row ?: return
+        row.setOnClickListener {
+            val text = valueView.text?.toString().orEmpty()
+            if (text.isBlank()) return@setOnClickListener
+            val ok = SagerNet.trySetPrimaryClip(text)
+            android.widget.Toast.makeText(
+                requireContext(),
+                if (ok) R.string.copy_success else R.string.copy_failed,
+                android.widget.Toast.LENGTH_SHORT
+            ).show()
+        }
+    }
+
+    private fun defaultSecondaryColor(): Int {
+        val ta = requireContext().theme.obtainStyledAttributes(
+            intArrayOf(android.R.attr.textColorSecondary)
+        )
+        val color = ta.getColor(0, 0)
+        ta.recycle()
+        return color
+    }
+
+    private fun setLoadingState() {
+        ipValue.setText(R.string.ip_loading)
+        countryValue.setText(R.string.ip_loading)
+        levelValue.setText(R.string.ip_loading)
+        typeValue.setText(R.string.ip_loading)
+        flagsValue.setText(R.string.ip_loading)
+        orgValue.setText(R.string.ip_loading)
+        asnValue.setText(R.string.ip_loading)
+        sourceValue.text = "—"
+        levelValue.setTextColor(defaultSecondaryColor())
+    }
+
+    private fun render(q: IpQualityLookup.IpQuality) {
+        val levelRes = when (q.level) {
+            "risky" -> R.string.ip_level_risky
+            "good" -> R.string.ip_level_good
+            else -> R.string.ip_level_normal
+        }
+        val levelColor = when (q.level) {
+            "risky" -> ContextCompat.getColor(requireContext(), R.color.material_red_500)
+            "good" -> ContextCompat.getColor(requireContext(), R.color.material_green_500)
+            else -> defaultSecondaryColor()
+        }
+        val typeRes = when (q.type) {
+            "hosting" -> R.string.ip_type_hosting
+            "mobile" -> R.string.ip_type_mobile
+            "business" -> R.string.ip_type_business
+            else -> R.string.ip_type_residential
+        }
+        val labelOf = mapOf(
+            "tor" to getString(R.string.ip_flag_tor),
+            "abuser" to getString(R.string.ip_flag_abuser),
+            "vpn" to getString(R.string.ip_flag_vpn),
+            "proxy" to getString(R.string.ip_flag_proxy),
+        )
+        val flagsText = if (q.flags.isEmpty()) {
+            getString(R.string.ip_none)
+        } else {
+            q.flags.mapNotNull { labelOf[it] }.joinToString("、")
+        }
+        ipValue.text = q.ip
+        countryValue.text = q.country?.takeIf { it.isNotBlank() } ?: "—"
+        levelValue.setText(levelRes)
+        levelValue.setTextColor(levelColor)
+        typeValue.setText(typeRes)
+        flagsValue.text = flagsText
+        orgValue.text = q.organization?.takeIf { it.isNotBlank() } ?: "—"
+        asnValue.text = q.asn?.let { "AS$it" } ?: "—"
+        sourceValue.text = q.source
+    }
+
+    private fun renderError(err: String?) {
+        ipValue.setText(R.string.ip_query_failed)
+        countryValue.text = "—"
+        levelValue.text = err ?: ""
+        levelValue.setTextColor(
+            ContextCompat.getColor(requireContext(), R.color.material_red_500)
+        )
+        typeValue.setText(R.string.ip_query_failed)
+        flagsValue.setText(R.string.ip_none)
+        orgValue.text = "—"
+        asnValue.text = "—"
+        sourceValue.text = "—"
+    }
+
+    /**
+     * 028: force=false（打开）→ 同节点缓存秒显（跨节点/无缓存 → 立即“查询中”现查）；
+     * force=true（点刷新）→ 立即显示查询中，失败时回滚同节点缓存（不冲掉成功结果）。
+     */
+    private fun fetch(force: Boolean) {
+        if (loading) return
+        val profileId = DataStore.currentProfile
+        val cache = IpQualityLookup.cacheFor(profileId)
+        if (!force && cache != null) {
+            render(cache.quality)
+            return
+        }
+        // 028: 点刷新立刻进入查询中状态（人性化反馈，不再顶着旧信息干等）
+        loading = true
+        setLoadingState()
+        runOnDefaultDispatcher {
+            runCatching { IpQualityLookup.lookup(profileId) }
+                .onSuccess { q ->
+                    onMainDispatcher {
+                        if (isAdded) render(q)
+                        loading = false
+                    }
+                }
+                .onFailure { e ->
+                    Logs.w(e)
+                    onMainDispatcher {
+                        loading = false
+                        if (!isAdded) return@onMainDispatcher
+                        // 失败：回滚同节点缓存；无缓存才显示错误
+                        val c = IpQualityLookup.cacheFor(profileId)
+                        if (c != null) render(c.quality) else renderError(e.readableMessage)
+                    }
+                }
+        }
+    }
+}
