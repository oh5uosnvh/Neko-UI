<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback resource only; ReferenceSwitch owns exact measurement and 300ms transitions. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/switch_checked_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/switch_track_off" />
        </shape>
    </item>
</selector>
