<?xml version="1.0" encoding="utf-8"?>
<io.nekohasekai.sagernet.widget.TitleBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/colorLayerLow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ToolsFragment">

    <LinearLayout
        android:id="@id/title_bar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tools_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorLayerLow"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:tabIndicatorColor="?tabIndicatorColor"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?tabSelectedTextColor"
            app:tabTextColor="?tabTextColor"
            app:tabUnboundedRipple="false" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/tools_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</io.nekohasekai.sagernet.widget.TitleBarLayout>
