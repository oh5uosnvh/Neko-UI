<?xml version="1.0" encoding="utf-8"?>
<!-- Internal content only. ControlBar inflates this merge exactly once. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/control_bar_content"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:id="@+id/speed_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:minWidth="48dp"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/speed_down"
                style="@style/ControlBarSpeed.Down"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="start|center_vertical"
                android:importantForAccessibility="no"
                android:text="@string/control_bar_speed_down_unknown"
                android:textColor="@color/control_bar_text"
                tools:text="▼ 999.99 MB/s" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/speed_up"
                style="@style/ControlBarSpeed.Up"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="start|center_vertical"
                android:importantForAccessibility="no"
                android:text="@string/control_bar_speed_up_unknown"
                android:textColor="@color/control_bar_text"
                tools:text="▲ 999.99 MB/s" />
        </LinearLayout>

        <!-- The whole 48dp target is clickable; its wrap-content icon/label pair is centered. -->
        <FrameLayout
            android:id="@+id/capsule"
            android:layout_width="118dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_capsule"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:foreground="@null"
            android:importantForAccessibility="yes"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/capsule_pair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:baselineAligned="false"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/capsule_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:tint="@color/control_bar_text"
                    app:srcCompat="@drawable/ic_control_power" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/capsule_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/control_bar_disconnected"
                    android:textColor="@color/control_bar_text"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="0.5sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/latency_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:minWidth="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/latency"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:gravity="end|center_vertical"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/control_bar_latency_unknown"
                android:textColor="@color/latency_green"
                android:textSize="16sp"
                android:textStyle="normal"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="0.5sp"
                tools:text="9999 ms" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/latency_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|center_vertical"
                android:visibility="gone"
                android:importantForAccessibility="no"
                app:tint="@color/latency_green"
                app:srcCompat="@drawable/ic_control_connecting" />
        </FrameLayout>
    </LinearLayout>
</merge>
