        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/subscription_user_agent"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_image_edit" />

</FrameLayout>
