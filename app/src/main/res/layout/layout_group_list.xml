<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque toolbar above a full-height pager; transparent theme-pill tabs float
     in front. Only scrolling content near the toolbar baseline is softened. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/colorLayerLow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Pager owns the full area below the opaque app bar. Only individual pills
         are foreground surfaces; scrolling cards continue behind their gaps. -->
    <io.nekohasekai.sagernet.widget.GroupListEdgeLayout
        android:id="@+id/group_list_foreground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="false">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/group_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <io.nekohasekai.sagernet.widget.GroupPillTabLayout
            android:id="@+id/group_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:visibility="gone"
            app:tabBackground="@android:color/transparent"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabIndicatorFullWidth="false"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"
            app:tabPaddingStart="4dp"
            app:tabPaddingEnd="4dp"
            app:tabPaddingTop="7dp"
            app:tabPaddingBottom="7dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?android:attr/textColorPrimary"
            app:tabTextColor="?android:attr/textColorPrimary"
            app:tabUnboundedRipple="false" />
    </io.nekohasekai.sagernet.widget.GroupListEdgeLayout>

</LinearLayout>
