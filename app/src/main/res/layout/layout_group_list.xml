<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque toolbar above a full-height pager; transparent theme-pill tabs float
     in front. Only scrolling content near the toolbar baseline is softened. -->
<io.nekohasekai.sagernet.widget.TitleBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/colorLayerLow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ConfigurationFragment">

    <!-- Pager owns the full area below the title glyph. The edge container keeps
         its own pager-only blur so the floating group pills remain crisp. -->
    <io.nekohasekai.sagernet.widget.GroupListEdgeLayout
        android:id="@+id/group_list_foreground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="false">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/group_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </io.nekohasekai.sagernet.widget.GroupListEdgeLayout>

    <include
        layout="@layout/layout_appbar_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</io.nekohasekai.sagernet.widget.TitleBarLayout>
