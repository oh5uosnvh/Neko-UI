<?xml version="1.0" encoding="utf-8"?>
<io.nekohasekai.sagernet.widget.TitleBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorLayerLow"
    tools:context=".ui.ToolsFragment">

    <!-- Padding belongs to the scroll surface, not an outer clipped container:
         scrolled text can then reach the title's fade band. -->
    <FrameLayout
        android:id="@id/title_bar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scroolview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp">

            <TextView
                android:id="@+id/textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:ems="10"
                android:focusable="true"
                android:gravity="start|top"
                android:textIsSelectable="true"
                tools:ignore="LabelFor" />
        </ScrollView>
    </FrameLayout>

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</io.nekohasekai.sagernet.widget.TitleBarLayout>