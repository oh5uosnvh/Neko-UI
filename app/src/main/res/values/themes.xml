        <!-- Keep the card fill exact: Material must not tint it again at elevation. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="cardElevatedSurfaceColor">?attr/colorLayerHigh</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.SagerNet.LayeredToolbar</item>
        <!-- White unselected tabs disappear on the MD light chrome; use DayNight foreground. -->
        <item name="tabTextColor">?android:attr/textColorSecondary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabRippleColor">?attr/colorPrimary</item>
        <item name="whiteOrTextPrimary">?android:attr/textColorPrimary</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.AlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialCardViewStyle">@style/Widget.SagerNet.CardView</item>
        <item name="textInputStyle">@style/Widget.SagerNet.TextInputLayout</item>
        <item name="popupMenuStyle">@style/Widget.SagerNet.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.SagerNet.PopupMenu.Overflow</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SagerNet.BottomSheetDialog</item>
        <item name="materialButtonStyle">@style/Widget.SagerNet.Button</item>

        <!-- 与 Theme.SagerNet.Base 保持一致（此主题不继承 Base）：无按压底色 + 全局开关样式 -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="switchStyle">@style/Widget.SagerNet.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.SagerNet.Switch</item>

        <item name="android:dialogCornerRadius">@dimen/dialog_corner_radius</item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <!-- Inherit the activity's DayNight foreground, never force a dark-actionbar white. -->
    <style name="ThemeOverlay.SagerNet.LayeredToolbar" parent="">
        <item name="colorControlNormal">?android:attr/textColorPrimary</item>
        <item name="android:colorControlNormal">?android:attr/textColorPrimary</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="subtitleTextColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- A popup is raised content, not the application's lower window background. -->
    <style name="ThemeOverlay.SagerNet.LayeredPopup" parent="ThemeOverlay.AppCompat.DayNight">
        <item name="android:colorBackground">?attr/colorLayerHigh</item>
        <item name="colorSurface">?attr/colorLayerHigh</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <!-- 弹窗浮层自带圆角底色（windowBackground = @drawable/bg_dialog），
             页面底色与弹窗底色本就不同，背后不要再压暗 scrim。 -->
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 弹窗动态展开/收起，与列表菜单一致。 -->
        <item name="android:windowAnimationStyle">@style/DialogWindowAnimation</item>
        <item name="colorLayerLow">@color/layer_low</item>
        <item name="colorLayerHigh">@color/layer_high</item>
        <item name="colorLayerStroke">@color/layer_stroke</item>
        <item name="colorSurface">?attr/colorLayerHigh</item>
        <item name="android:colorBackground">?attr/colorLayerHigh</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SagerNet.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary
        </item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">30dp</item>
        <item name="textEndPadding">30dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <style name="Widget.SagerNet.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardBackgroundColor">?attr/colorLayerHigh</item>
    </style>

    <!-- ElevatedCard: shadow + tonal surface, no stroke. -->
    <style name="Widget.SagerNet.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?attr/colorLayerHigh</item>
    </style>

    <style name="Widget.SagerNet.CardView.Tinted" parent="Widget.SagerNet.CardView">
        <item name="cardBackgroundColor">?attr/colorLayerHigh</item>
    </style>

    <style name="ShapeAppearanceOverlay.SagerNet.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialog_corner_radius</item>
    </style>

    <style name="ShapeAppearanceOverlay.SagerNet.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/input_corner_radius</item>
    </style>
    <style name="Widget.SagerNet.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SagerNet.Input</item>
    </style>

    <style name="PopupMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>

    <!-- 弹窗窗口动画（windowAnimationStyle）：进入 scale(0.85→1)+fade 180ms 减速，退出 fade 120ms -->
    <style name="DialogWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="Widget.SagerNet.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupAnimationStyle">@style/PopupMenuAnimation</item>
    </style>
    <style name="Widget.SagerNet.PopupMenu.Overflow" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupAnimationStyle">@style/PopupMenuAnimation</item>
    </style>

    <style name="ShapeAppearanceOverlay.SagerNet.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/dialog_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/dialog_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Widget.SagerNet.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorLayerHigh</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SagerNet.BottomSheet</item>
    </style>
    <style name="ThemeOverlay.SagerNet.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SagerNet.BottomSheet</item>
    </style>

    <style name="ShapeAppearanceOverlay.SagerNet.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/button_corner_radius</item>
    </style>
    <style name="Widget.SagerNet.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SagerNet.Button</item>
    </style>

    <!-- 全局开关：绿色胶囊 track + 白色圆 thumb。
         SwitchMaterial 的自动着色仅在 thumbTint 与 trackTint 均为空时生效，
         这里显式给出非空 tint（与 drawable 同一组颜色），既锁定配色又杜绝
         父样式（Widget.MaterialComponents.CompoundButton.Switch）继承下来的着色；
         thumb 的滑动过渡是 SwitchCompat/SwitchMaterial 自带的位置动画，不受影响。 -->
    <style name="Widget.SagerNet.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb_sagernet</item>
        <item name="android:track">@drawable/switch_track_sagernet</item>
        <item name="android:thumbTint">@color/switch_thumb_color</item>
        <item name="android:trackTint">@color/switch_track_color</item>
        <item name="useMaterialThemeColors">false</item>
    </style>

    <style name="ShapeAppearance.SagerNet.NavItem" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/nav_item_corner_radius</item>
    </style>

