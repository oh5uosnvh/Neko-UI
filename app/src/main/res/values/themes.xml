<resources>
    <!-- Shared bag: API-qualified Theme.SagerNet must also inherit this base. -->
    <style name="Theme.SagerNet" parent="Theme.SagerNet.Base" />

    <style name="Theme.SagerNet.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?attr/colorLayerLow</item>
        <item name="colorLayerLow">@color/layer_low</item>
        <item name="colorLayerHigh">@color/layer_high</item>
        <item name="colorLayerStroke">@color/layer_stroke</item>
        <item name="android:windowBackground">?attr/colorLayerLow</item>
        <item name="android:colorBackground">?attr/colorLayerLow</item>
        <item name="colorSurface">?attr/colorLayerHigh</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/material_blue_grey_700</item>
        <item name="colorAccent">@color/brand_primary</item>

        <item name="colorMaterial100">@color/material_blue_grey_100</item>
        <item name="colorMaterial300">@color/brand_primary_light</item>

        <!-- Keep the card fill exact: Material must not tint it again at elevation. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="cardElevatedSurfaceColor">?attr/colorLayerHigh</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.SagerNet.LayeredToolbar</item>
        <!-- White unselected tabs disappear on the MD light chrome; use DayNight foreground. -->
        <item name="tabTextColor">?android:attr/textColorSecondary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabRippleColor">?attr/colorPrimary</item>
        <item name="whiteOrTextPrimary">?android:attr/textColorPrimary</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.AlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialCardViewStyle">@style/Widget.SagerNet.CardView</item>
        <item name="textInputStyle">@style/Widget.SagerNet.TextInputLayout</item>
        <item name="popupMenuStyle">@style/Widget.SagerNet.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.SagerNet.PopupMenu.Overflow</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SagerNet.BottomSheetDialog</item>
        <item name="materialButtonStyle">@style/Widget.SagerNet.Button</item>

        <!-- 按压涟漪/高亮全部透明：设置行、编辑入口、列表菜单项的点击反馈
             就是随之打开的弹窗 / 列表菜单本身，不需要底色变化。
             本主题 parent 为 DayNight，此声明日/夜间同时生效。 -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>

        <!-- 全局开关样式：绿色胶囊 track + 白色圆 thumb（滑动动画是 Switch 自带的）。
             switchStyle 覆盖 SwitchMaterial / SwitchCompat / SwitchPreference(Compat)，
             materialSwitchStyle 覆盖 Material 1.7+ 的 MaterialSwitch。 -->
        <item name="switchStyle">@style/Widget.SagerNet.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.SagerNet.Switch</item>

    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?attr/colorLayerLow</item>
        <item name="colorLayerLow">@color/layer_low</item>
        <item name="colorLayerHigh">@color/layer_high</item>
        <item name="colorLayerStroke">@color/layer_stroke</item>
        <item name="android:windowBackground">?attr/colorLayerLow</item>
        <item name="android:colorBackground">?attr/colorLayerLow</item>
        <item name="colorSurface">?attr/colorLayerHigh</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/material_blue_grey_700</item>
        <item name="colorAccent">@color/brand_primary</item>

        <item name="colorMaterial100">@color/material_blue_grey_100</item>
