<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ControlBarSpeed" parent="">
        <!-- Spannable unit coloring is incompatible with autosize; a fixed 12sp base
             keeps the worst "▼ 9.88 GB/s" case inside the narrow-320dp budget. -->
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="ControlBarSpeed.Down" parent="ControlBarSpeed">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ControlBarSpeed.Up" parent="ControlBarSpeed">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
